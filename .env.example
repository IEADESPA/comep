# Copie este arquivo para ".env.local" e preencha com os dados do projeto Supabase de TESTE.
# ".env.local" nunca vai para o repositório (está no .gitignore).
#
# Só entram aqui as informações PÚBLICAS do Supabase: o endereço do projeto e a chave
# publishable (sb_publishable_...). A chave secreta (sb_secret_... / service_role) e a
# senha do banco NUNCA entram neste arquivo nem no código.

VITE_SUPABASE_URL=https://SEU-PROJETO.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...
